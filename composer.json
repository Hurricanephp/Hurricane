{
    "name": "hurricanephp/hurricane",
    "description": "Hurricane is an asynchronous framework for php",
    "keywords": [
        "hurricanephp",
        "asynchronous",
        "framework",
        "hurricane",
        "async",
        "event-loop",
        "promises"
    ],
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "vlucas/phpdotenv": "^5.7"
    },
    "require-dev":{
        "laravel/pint": "^1.32",
        "pestphp/pest": "^5.2",
        "phpstan/phpstan": "^2.2",
        "symfony/var-dumper": "^8.1"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "bin": [
        "bin/hurricane"
    ],
    "authors": [
        {
            "name": "Sushil Kumar",
            "email": "sushilkumbhar77@gmail.com"
        }
    ],
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
