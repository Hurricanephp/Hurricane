{
    "name": "hurricanephp/hurricane",
    "description": "Hurricane is an asynchronous framework for php",
    "keywords": [
        "hurricanephp",
        "asynchronous",
        "framework",
        "hurricane",
        "async",
        "event-loop",
        "promises"
    ],
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "authors": [
        {
            "name": "Sushil Kumar",
            "email": "sushilkumbhar77@gmail.com"
        }
    ],
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
