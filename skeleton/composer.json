{
    "name": "hurricanephp/skeleton",
    "description": "Hurricane 🌀 application skeleton for building modern, modular and async PHP applications.",
    "keywords": [
        "hurricane",
        "hurricanephp",
        "php",
        "framework",
        "application",
        "async",
        "reactive",
        "web",
        "api"
    ],
    "type": "project",
    "license": "MIT",

    "require": {
        "php": "^8.4",
        "hurricanephp/framework": "*",
        "vlucas/phpdotenv": "^5.7"
    },

    "require-dev": {
        "laravel/pint": "^1.32",
        "pestphp/pest": "^5.2",
        "phpstan/phpstan": "^2.2",
        "symfony/var-dumper": "^8.1"
    },

    "repositories": [
        {
            "type": "path",
            "url": "../framework",
            "options": {
                "symlink": true
            }
        }
    ],

    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },

    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },

    "scripts": {
        "test": "@php vendor/bin/pest",
        "analyse": "@php vendor/bin/phpstan analyse",
        "lint": "@php vendor/bin/pint",
        "lint:check": "@php vendor/bin/pint --test",
        "check": [
            "@lint:check",
            "@analyse",
            "@test"
        ]
    },

    "config": {
        "sort-packages": true,
        "preferred-install": {
            "*": "dist"
        },
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },

    "minimum-stability": "dev",
    "prefer-stable": true
}
